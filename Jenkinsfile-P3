pipeline {
    agent any
    environment {
        SYS_NAME = 'StudentPerformancePortal'
        SYS_VERSION = 'v2.4.0'
    }
    stages {
        stage('Checkout Source') {
            steps {
                git branch: 'main', url: 'https://github.com/Dilip-087/student-devops-system.git'
            }
        }
        stage('Show Configuration Info') {
            steps {
                echo "Spinning up environment for ${env.SYS_NAME}"
                echo "Current Build Target Version: ${env.SYS_VERSION}"
            }
        }
        stage('Simulate Build Verification') {
            steps {
                echo "Success: ${env.SYS_NAME} (${env.SYS_VERSION}) compiled without errors."
            }
        }
    }
}

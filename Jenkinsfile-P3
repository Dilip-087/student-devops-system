pipeline {
    agent any
    stages {
        stage('Checkout Source') {
            steps {
                git branch: 'main', url: 'https://github.com/Dilip-087/student-devops-system'
            }
        }
        stage('Parallel Portal Verifications') {
            parallel {
                stage('Frontend Validation') {
                    steps {
                        echo 'Starting frontend interface validation checks...'
                        bat 'python frontend_check.py'
                    }
                }
                stage('Backend Validation') {
                    steps {
                        echo 'Starting backend server framework validation checks...'
                        bat 'python backend_check.py'
                    }
                }
            }
        }
        stage('Deployment Summary') {
            steps {
                echo 'Pipeline Success: Concurrency targets achieved. All modules are production ready.'
            }
        }
    }
}
